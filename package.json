{
  "name": "@kne/fastify-mcp",
  "version": "0.1.5",
  "description": "Fastify MCP 宿主插件：Streamable HTTP、OpenAPI 能力索引、全局 allowlist REST、安装引导 Markdown",
  "main": "index.js",
  "scripts": {
    "init": "husky",
    "build:md": "npx @kne/md-doc",
    "start:md": "npx @kne/md-doc --watch",
    "test": "mocha test/**/*.test.js --timeout 15000",
    "prettier": "prettier --config .prettierrc --write '{libs/**/*,index}.{js,jsx,ts,tsx,json,css,scss}'",
    "lint-staged": "npx lint-staged"
  },
  "lint-staged": {
    "{libs/**/*,index}.{js,jsx,ts,tsx,json,css,scss}": [
      "prettier --config .prettierrc --write",
      "git add"
    ]
  },
  "files": [
    "index.js",
    "libs",
    "MCP.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kne-union/fastify-mcp.git"
  },
  "keywords": [
    "fastify",
    "mcp",
    "model-context-protocol",
    "openapi",
    "allowlist",
    "fastify-plugin"
  ],
  "author": "linzp",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kne-union/fastify-mcp/issues"
  },
  "homepage": "https://github.com/kne-union/fastify-mcp#readme",
  "peerDependencies": {
    "@kne/fastify-intl": ">=0.1.7",
    "@kne/fastify-namespace": "*",
    "@kne/fastify-sequelize": "*",
    "fastify-plugin": ">=5"
  },
  "devDependencies": {
    "@fastify/env": "^5.0.2",
    "@fastify/swagger": "^9.9.5",
    "@kne/fastify-intl": "^0.1.7",
    "@kne/fastify-namespace": "^1.2.1",
    "@kne/fastify-sequelize": "^3.2.0",
    "chai": "^4.5.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "husky": "^9.0.11",
    "mocha": "^12.0.3",
    "nodemon": "^3.1.3",
    "prettier": "^3.2.5",
    "sqlite3": "^5.1.7"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "qs": "^6.17.1",
    "zod": "^4.6.7"
  }
}
